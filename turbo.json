{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "lint": {},
    "format": {},
    "typecheck": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "ci:verify": {
      "dependsOn": ["^build"]
    },
    "check": {},
    "check:structural": {},
    "check:host": {
      "cache": false
    },
    "matrix": {
      "cache": false
    },
    "test:automation": {
      "cache": false
    }
  }
}
